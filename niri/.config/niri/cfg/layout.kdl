layout {
    gaps 16 // Gap between windows
    center-focused-column "never" // Don’t auto-center focused column

    background-color "transparent" // <- needed for noctalia-shell to set wallpaper

    // Active window highlight
    focus-ring {
        width 1.5
        active-color "#6A329F"   // Color for the window you are currently using
        inactive-color "#1e2030" // Color for the background windows
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    struts {}
}
